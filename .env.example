# === ElevenLabs TTS (disarankan untuk Pak Nam & Zaba) ===
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Provider: elevenlabs | edge
TTS_PROVIDER=elevenlabs

# Opsional — override model (default di config: eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Voice IDs (sudah di config/characters.paknam-zaba.json):
#   Pak Nam: aK834gEOxQEtviMPgurT
#   Zaba:    JaUVfDrFcfwGIsv8X2kN

# === YouTube upload ===
# OAuth: config/youtube/client_secret.json + python scripts/youtube/auth.py
# Lihat docs/YOUTUBE.md
YOUTUBE_PRIVACY_DEFAULT=unlisted
YOUTUBE_CATEGORY_ID=28

# === LLM otomasi VPS / daily job ===
ANTHROPIC_API_KEY=sk-ant-...

# === OpenClaw (opsional) ===
# PAPER2VIDEO_USE_OPENCLAW=1
# OPENAI_API_KEY=...
