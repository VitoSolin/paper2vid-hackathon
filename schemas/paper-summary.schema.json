{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperSummary",
  "type": "object",
  "required": [
    "arxiv_id",
    "title",
    "abstract",
    "problem",
    "method",
    "main_findings",
    "why_important",
    "limitations"
  ],
  "properties": {
    "arxiv_id": { "type": "string" },
    "title": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "published": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "pdf_url": { "type": "string" },
    "abstract": { "type": "string" },
    "problem": { "type": "string" },
    "method": { "type": "string" },
    "main_findings": { "type": "string" },
    "why_important": { "type": "string" },
    "limitations": { "type": "string" },
    "sources": {
      "type": "object",
      "properties": {
        "used_abstract": { "type": "boolean" },
        "used_pdf": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
